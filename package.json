{
  "name": "havet-arena",
  "version": "1.0.0",
  "description": "Badevannskvalitet for Havet Arena, Nyhavna i Trondheim",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "serve": "npx serve -p 8080",
    "deploy:worker": "wrangler deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  },
  "keywords": [
    "badevann",
    "havet-arena",
    "nyhavna",
    "trondheim",
    "e-coli"
  ],
  "author": "",
  "license": "MIT"
}
